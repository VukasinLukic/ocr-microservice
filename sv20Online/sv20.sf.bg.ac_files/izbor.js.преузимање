function showIzbor(source, width, height, page) {

    if ($("#modal1").is(":visible")) {
        showIzbor2(source, width, height, page);
        return;
    }

    $("#modal1").show();
    $("#show_modal").click();

    $("#iframeidModalG").height(height);
    $("#iframeidModalG").width(width);
    $("#iframeidModalG").attr("src", source);

    var func = function () { $('#iframeidModalG')[0].contentWindow.initParentPage(page); };
    if ($('#iframeidModalG')[0].addEventListener)
        $('#iframeidModalG')[0].addEventListener('load', func, true);
    else if ($('#iframeidModalG')[0].attachEvent)
        $('#iframeidModalG')[0].attachEvent('onload', func);

    $("#cont_modal1").height(parseInt(height) + 10);
    $("#cont_modal1").width(parseInt(width) + 10);
    $("#modal_iframe").show();

}


