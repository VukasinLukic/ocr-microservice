function convertMyListToOptions(selCtrl, sOptions) {

    var options = [];
    selCtrl.options.length = 0;

    if (sOptions != "|" && typeof sOptions != 'undefined')
        options = ("0~--------|" + sOptions).split('|');
    else
        options = ("0~--------|").split('|');

    var duzina = options.length;

    if (sOptions == "" || sOptions == "|" || typeof sOptions == 'undefined')
        duzina = options.length - 1;

    for (i = 0; i < duzina; i++) {
        var anOption = document.createElement("OPTION");

        try {
            selCtrl.options.add(anOption);

        }
        catch (ex) {
            selCtrl.options.add(anOption, null);

        }

        anOption.text = options[i].split('~')[1];
        anOption.value = options[i].split('~')[0];
    }
}

