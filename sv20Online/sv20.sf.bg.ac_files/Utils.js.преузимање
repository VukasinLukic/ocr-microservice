                  mesec == "9")) {
        return false; // samo 1,3,5,7,8,10,12 ima 31 dan
    }
    else
        if (mesec == "2") {
            //prestupna godina
            if (god % 4 == 0)
                if (dan == "30" || dan == "31")
                    return false;
                else
                    return true;
            else
                if (dan == "29" || dan == "30" || dan == "31")
                    return false;
                else

                    if (mesec > 12)
                        return false;
                    else
                        return true;
        }
        else
            return true;
    }

