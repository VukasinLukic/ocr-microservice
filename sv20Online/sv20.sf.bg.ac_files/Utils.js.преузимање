function convertMyListToAutocompleate(inpCtrl, sOptions, imeFunkcije, brojSlovaZaAutocomplete) {

    var options = [];

    options = sOptions.split('|');

    var availableTags = [];

    for (i = 0; i < options.length; i++) {
        availableTags[i] = options[i].split('~')[1];
    }

    inpCtrl.autocomplete({
        source: availableTags,
        select: function (event, ui) {

            if (imeFunkcije != "")
                imeFunkcije(ui, sOptions);
        },
        position: { my: "right top", at: "right bottom" }
    });
    inpCtrl.autocomplete("option", "minLength", brojSlovaZaAutocomplete);
}



function search_Array(ArrayObj, SearchFor) {
    var Found = false;
    for (var i = 0; i < ArrayObj.length; i++) {
        if (ArrayObj[i].split('~')[1].toLowerCase() == SearchFor.toLowerCase()) {
            return i;
            var Found = true;
            break;
        }
        else if ((i == (ArrayObj.length - 1)) && (!Found)) {
            if (ArrayObj[i].split('~')[1].toLowerCase() != SearchFor.toLowerCase()) {
                return -1;
            }
        }
    }
}

function search_ArrayByKey(ArrayObj, SearchFor) {
    var Found = false;
    for (var i = 0; i < ArrayObj.length; i++) {
        if (ArrayObj[i].split('~')[0] == SearchFor) {
            return i;
            var Found = true;
            break;
        }
        else if ((i == (ArrayObj.length - 1)) && (!Found)) {
            if (ArrayObj[i].split('~')[0] != SearchFor) {
                return -1;
            }
        }
    }
}



function decimalForDB(value) {
    var res;
    res = value.replace(',', '.');
    return res;
}


function dateForDB(value) {
    if (value == "")
        return value;

    return value.split('.')[1] + '/' + value.split('.')[0] + '/' + value.split('.')[2];
}


function getValueSifarnikForDB(el) {
    var res = el.val();
    if (el.length > 0) {
        if (el.attr('vrsta') == 'DAT') {
            res = dateForDB(el.val());
        }
        if (el.attr('vrsta') == 'DEC2') {
            res = decimalForDB(el.val());
        }
        if (el.attr('vrsta') == 'DEC3') {
            res = decimalForDB(el.val());
        }
        if (res != null)
            res = res.toString().replace("'", "");
    }
    return res;
}

function proveriSifarnikEntiteti(txtBox, sifarnik, tip_autofil) {
    //txtBox - kontrola koja se ispituje; sifarnik - niz koji se pretrazuje; tip_autofil - 0:samo iz sifarnika, 1 - moze i otvoreno polje za unos... 
    //tip_autofil podrazumeva ako je  1 da je txtbox sa id koji se zavrsava sa _desc, pa on upisuje u id koji je bez _desc, 
    // ako je 0 onda podrazumeva da se zavrsava sa _broj pa on smanjuje za 1 (uvedeno zbog sifarnika...)

    var id = search_Array(sifarnik.split('|'), txtBox.value);

    if (id == -1) {
        if (tip_autofil != 0) {            
            var broj = parseInt(txtBox.id.split('Kol')[1]);
            $('#Kol' + (broj - 1)).val("0");
        }
        else {
            alert('Morate odabrati jedno od ponuđenih opcija!');
            $('#' + txtBox.id).val("");
            $('#' + txtBox.id.substring(0, txtBox.length - 4)).val("0");
        }
    }
    else {
        
        if (tip_autofil != 0) {
            var broj = parseInt(txtBox.id.split('Kol')[1]) ;
            $('#Kol' + (broj-1)).val(sifarnik.split('|')[id].split('~')[0]);
        }
        else {
            $('#' + txtBox.id.substring(0, txtBox.id.length - 5)).val(sifarnik.split('|')[id].split('~')[0]);
        }
        
    }
}

function proveriSifarnik(txtBox, sifarnik) {
    var id = search_Array(sifarnik.split('|'), txtBox.value);
    if (id == -1) {
        alert('Morate odabrati jedno od ponuđenih opcija!');
        $('#' + txtBox.id).val("");
        $('#' + txtBox.id + '_id').val("0");
    }
    else {
        $('#' + txtBox.id + '_id').val(sifarnik.split('|')[id].split('~')[0]);
    }
}

function proveriObavezne(el) {
    var res = true;
    $(el).contents().find("input[obavezan],select[obavezan],textarea[obavezan]").each(function () {
        if ($(this).is(":visible")) {
            if ($(this).is("select") && $(this).find('option[value="' + $(this).val() + '"]').text() == "--------") {
                $(this).parent().addClass('danger');
                res = false;
            }
            if ($(this).val() == "") {
                $(this).parent().attr('class', 'field danger');
                res = false;
            }
        }
        else {
            if($(this).attr("multiple")!=null)
                if ($(this).val() ==null) {
                    $(this).parent().addClass('field danger');
                    res = false;
                }
        }
    });
    return res;
}

function removeDanger(el) {
    $(el).parent().attr('class', $(el).parent().attr('class').replace("danger", "")); //ukoliko je upisan danger izbacuje ga...
    if ($(el).parent().find('span[class=adjoined]').length > 0)
    { $(el).parent().find('span[class=adjoined]').hide(); }
}

function validateRegEx(el) {
    var reg = $(el).attr('reg');

    if (reg.toString().slice(0, 1) == '^' && reg.toString().slice(-1) == '$') {
        var r = new RegExp(reg);

        el.value = el.value.replace(/^\s+|\s+$/g, "");
        el.value = el.value.replaceAll("|", "");

        if (!el.value.match(r)) {
            el.value = "";
            $(el).parent().addClass('danger');
            if ($(el).parent().find('span[class=adjoined]').length > 0)
            { $(el).parent().find('span[class=adjoined]').show(); }
        }
    }
}

String.prototype.replaceAll = function (str1, str2, ignore) {
    return this.replace(new RegExp(str1.replace(/([\/\,\!\\\^\$\{\}\[\]\(\)\.\*\+\?\|\<\>\-\&])/g, "\\$&"), (ignore ? "gi" : "g")), (typeof (str2) == "string") ? str2.replace(/\$/g, "$$$$") : str2);
} 

function getDocumentHeight() {

    var body = document.body,
            html = document.documentElement;

    var height = Math.max(body.scrollHeight, body.offsetHeight,
                       html.clientHeight, html.scrollHeight, html.offsetHeight);

    return height;
}

function getDocumentWidth() {

    var body = document.body,
            html = document.documentElement;

    var width = Math.max(body.scrollWidth, body.offsetWidth,
                       html.clientWidth, html.scrollWidth, html.offsetWidth);

    return width;
}



